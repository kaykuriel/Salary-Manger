# Copy this file to .env.local and fill in your values.
# In Vercel: add these in Project → Settings → Environment Variables.

# Supabase — find in: supabase.com → project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # "service_role" key (secret — never expose to browser)

# JWT secret — generate any random string of 32+ characters
# e.g.: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret
